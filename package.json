{
  "name": "ai-agriculture-assistant",
  "version": "1.0.0",
  "description": "AI-powered Agriculture Assistant with crop disease detection, irrigation optimization, harvest prediction, pest identification, and soil analysis",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon backend/server.js",
    "client": "cd frontend && npm start",
    "seed": "node backend/seed.js",
    "setup": "npm install && cd frontend && npm install --legacy-peer-deps",
    "test": "jest --testPathPatterns=backend/__tests__ --forceExit --detectOpenHandles",
    "test:watch": "jest --testPathPatterns=backend/__tests__ --watch --forceExit",
    "test:coverage": "jest --testPathPatterns=backend/__tests__ --coverage --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^8.0.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.11.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
